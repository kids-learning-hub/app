rules_version = '2';
// Kids Learning Hub: paste into Firebase console → Firestore → Rules.
// Each signed-in adult can reach only their own document (see account.js).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['stars', 'favs', 'lang', 'updated'])
        && request.resource.data.stars is map
        && request.resource.data.favs is list
        && request.resource.data.favs.size() <= 200
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 5;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
