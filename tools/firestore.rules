rules_version = '2';
// Kids Learning Hub: paste into Firebase console → Firestore → Rules.
// Each signed-in adult can reach only their own document (see account.js).
service cloud.firestore {
  match /databases/{database}/documents {
    function validProfile(p) {
      return p.keys().hasOnly(['name', 'phone', 'country', 'role', 'contactOk', 'email'])
        && p.name is string && p.name.size() <= 80
        && p.phone is string && p.phone.size() <= 24
        && p.country is string && p.country.size() <= 60
        && p.role in ['parent', 'teacher', 'other']
        && p.contactOk is bool
        && p.email is string && p.email.size() <= 254;
    }
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['stars', 'favs', 'lang', 'updated', 'profile'])
        && request.resource.data.stars is map
        && request.resource.data.favs is list
        && request.resource.data.favs.size() <= 200
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 5
        && (!('profile' in request.resource.data) || validProfile(request.resource.data.profile));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
